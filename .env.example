# ==============================================================================
# Smart LLM Router - Environment Configuration Template
# Copy this file to `.env` and fill in your actual API keys.
# DO NOT commit your `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Provider API Keys
# ------------------------------------------------------------------------------
# Jev Semantic Classifier (via typesafe-sdk)
JEV_API_KEY=your_jev_api_key_here

# NVIDIA NIM (Primary Execution Provider)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# OpenRouter (Resilient Fallback Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# Provider Base URLs
# ------------------------------------------------------------------------------
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Model Mappings (NVIDIA NIM Primary)
# ------------------------------------------------------------------------------
NVIDIA_FAST_MODEL=mistralai/mistral-nemotron
NVIDIA_CODING_MODEL=mistralai/mistral-nemotron
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ------------------------------------------------------------------------------
# Model Mappings (OpenRouter Fallback)
# ------------------------------------------------------------------------------
OPENROUTER_FAST_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODEL=openrouter/auto
OPENROUTER_CODING_MODEL=openrouter/auto
OPENROUTER_REASONING_MODEL=openrouter/auto

# ------------------------------------------------------------------------------
# Routing Policies & Gating
# ------------------------------------------------------------------------------
# Queries classified with confidence below this threshold fallback to REASONING
CONFIDENCE_THRESHOLD=0.70

# Request timeout in seconds before primary triggers failover to fallback provider
TIMEOUT_SECONDS=12.0
MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Observability & Storage
# ------------------------------------------------------------------------------
DB_PATH=telemetry.db
